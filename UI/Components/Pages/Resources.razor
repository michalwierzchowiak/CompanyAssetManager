@page "/resources"
@using Microsoft.AspNetCore.SignalR.Client
@using Core
@using System.Net.Http.Headers
@inject HttpClient Http
@inject UI.Services.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Zasoby</PageTitle>

<h1>Lista Zasobów (Live)</h1>

<div class="input-group mb-3">
    <input @bind="newResourceName" class="form-control" placeholder="Nazwa nowego zasobu..." />
    <button @onclick="AddResource" class="btn btn-success">Dodaj</button>
</div>

@if (resources == null)
{
    <p>Ładowanie...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nazwa</th>
                <th>Data utworzenia</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in resources)
            {
                <tr class="animate-fade-in">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.CreatedAt</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Resource> resources = new();
    private string newResourceName = "";
    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(AuthService.Token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthService.Token);
            resources = await Http.GetFromJsonAsync<List<Resource>>("api/resources") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Błąd pobierania danych: " + ex.Message);
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5000/notificationsHub")
            .Build();

        hubConnection.On<Resource>("ReceiveResource", (resource) =>
        {
            resources.Add(resource);
            InvokeAsync(StateHasChanged);
        });

        
        try { await hubConnection.StartAsync(); }
        catch {  }
    }

    private async Task AddResource()
    {
        var newItem = new Resource { Name = newResourceName };
        var response = await Http.PostAsJsonAsync("api/resources", newItem);
        if (response.IsSuccessStatusCode)
        {
            newResourceName = ""; 
        }
    }


    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}