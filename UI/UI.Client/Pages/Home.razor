@page "/"

<PageTitle>Strona Główna</PageTitle>

<div class="text-center mt-5">
    <h1 class="display-4">System Rozproszony - Michał Wierzchowiak</h1>
    <p class="lead">Projekt zaliczeniowy: Tworzenie aplikacji rozproszonej w C# z wykorzystaniem repozytorium Git</p>

    <hr class="my-4">

    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Strefa Użytkownika</h5>
                    <p class="card-text">Zaloguj się, aby uzyskać token JWT i dostęp do systemu.</p>
                    <a href="login" class="btn btn-primary">Przejdź do logowania</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Zarządzanie Zasobami</h5>
                    <p class="card-text">Synchronizacja danych w czasie rzeczywistym (SignalR + RabbitMQ).</p>
                    <a href="resources" class="btn btn-success">Lista zasobów</a>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4" role="alert">
        <strong>Status systemu:</strong> UI działa poprawnie. Pamiętaj o uruchomieniu API!
    </div>
</div>