@page "/resources"
@using Microsoft.AspNetCore.SignalR.Client
@using Core
@using System.Net.Http.Headers
@using UI.Client.Services
@inject HttpClient Http
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Zasoby</PageTitle>

<h1>Lista Zasobów (Live)</h1>

<div class="input-group mb-3">
    <input @bind="newResourceName" class="form-control" placeholder="Nazwa nowego zasobu..." />
    <button @onclick="AddResource" class="btn btn-success">Dodaj</button>
</div>

@if (resources == null)
{
    <p>Inicjalizacja...</p>
}
else if (isLoading)
{
    <p>Ładowanie danych...</p>
}
else
{
    <div class="mb-2">
        <small class="text-muted">Status połączenia: @connectionStatus</small>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nazwa</th>
                <th>Data utworzenia</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in resources)
            {
                <tr class="animate-fade-in">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.CreatedAt</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Resource> resources = new();
    private string newResourceName = "";
    private HubConnection? hubConnection;
    private bool isLoading = true;
    private string connectionStatus = "Rozłączony";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrEmpty(AuthService.Token))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            try
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthService.Token);
                resources = await Http.GetFromJsonAsync<List<Resource>>("api/resources") ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Błąd HTTP: {ex.Message}");
            }
            finally
            {
                isLoading = false;
                StateHasChanged(); 
            }

            // 2. Połącz SignalR
            await StartSignalR();
        }
    }

    private async Task StartSignalR()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl("https://localhost:7237/notificationsHub", options => 
                {
                    options.AccessTokenProvider = () => Task.FromResult(AuthService.Token);
                })
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<Resource>("ReceiveResource", (resource) =>
            {
                resources.Add(resource);
                InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
            connectionStatus = "Połączono (Live)";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            connectionStatus = $"Błąd SignalR: {ex.Message}";
            Console.WriteLine(ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AddResource()
    {
        if (string.IsNullOrWhiteSpace(newResourceName)) return;

        var newItem = new Resource { Name = newResourceName };
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", AuthService.Token);

        var response = await Http.PostAsJsonAsync("api/resources", newItem);

        if (response.IsSuccessStatusCode)
        {
            newResourceName = "";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}